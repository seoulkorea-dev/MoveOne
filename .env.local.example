# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.

# 중요: 애플리케이션은 반드시 moveone_app 역할로 접속해야 합니다.
#   app 은 슈퍼유저이고, 슈퍼유저는 RLS를 통째로 우회합니다.
#   app 으로 접속하면 행 수준 접근 제어가 전혀 동작하지 않습니다.
#   마이그레이션(schema.sql, 002_security.sql)만 app 으로 실행합니다.
DATABASE_URL=postgresql://moveone_app:moveone_dev@localhost:5433/moveone

# 세션 서명 키
#   openssl rand -base64 48
SESSION_SECRET=

# ODsay (https://lab.odsay.com)
#
# 키가 두 개 필요합니다. 같은 값을 넣으면 한쪽이 반드시 실패합니다.
#
#   ODSAY_API_KEY           서버 전용. 경로 검색(searchPubTransPathT)·노선 선형(loadLane)
#                           콘솔에서 "Server" 플랫폼에 공인 IP 등록:  curl ifconfig.me
#
#   NEXT_PUBLIC_ODSAY_WEB_KEY  브라우저용. 지하철 노선도 SDK 가 씁니다
#                           콘솔에서 "Web" 플랫폼에 도메인 등록: http://localhost:4100
#                           카카오 JS 키와 같은 성격이라 브라우저에 노출됩니다
ODSAY_API_KEY=
NEXT_PUBLIC_ODSAY_WEB_KEY=

# 카카오 (https://developers.kakao.com) — 앱은 하나만
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# 메일 발송
#   console (기본) — 실제로 보내지 않고 터미널에 링크를 출력합니다.
#                    개발·시연에는 이걸로 충분합니다.
#   smtp           — lib/mailer.ts 의 sendViaSmtp 를 구현한 뒤 사용
MAIL_TRANSPORT=console

# 로그 레벨 — debug | info | error | silent
#   debug  모두 (개발 기본값). 값이 없어도 debug 로 동작합니다
#   error  오류만. 운영에서 쓸 값
# 브라우저 번들에 박히므로 바꾸면 개발 서버를 재시작해야 합니다.
NEXT_PUBLIC_LOG_LEVEL=debug
